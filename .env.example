# Local Docker Postgres (for local development)
DATABASE_URL="postgresql://notes_user:notes_password@127.0.0.1:5432/notes_everywhere"

# Production: set DATABASE_URL to your Neon connection string in Netlify's
# environment variables UI (Settings > Environment variables).
# Example: DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth cookie secret used to encrypt note-access session cookies
AUTH_COOKIE_SECRET="replace-with-a-long-random-secret"

# reCAPTCHA v3 — get keys at https://www.google.com/recaptcha/admin
# Leave both unset to skip verification in local development.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-site-key"
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"

# Set to "true" to enable recovery email flows and recovery routes.
RECOVERY_FEATURE_ENABLED="false"

# Brevo transactional email settings for recovery emails
BREVO_API_KEY="xkeysib-your-brevo-api-key"
# Use a sender email that is configured and allowed in your Brevo account.
BREVO_FROM_EMAIL="notes@example.com"
BREVO_FROM_NAME="TinyNotes"
